// 由 by-mgr display 管理，niri 自动引入
output "HDMI-A-1" {
    // 取消注释此行可禁用该显示器。
    // off

    // 分辨率与可选的刷新率。
    // 格式为“<宽度>x<高度>”或“<宽度>x<高度>@<刷新率>”。
    // 若省略刷新率，niri 会为该分辨率选择最高刷新率。
    // 若整个 mode 省略或无效，niri 会自动选择。
    // 在 niri 会话内运行 `niri msg outputs` 可查看所有输出及其可用模式。
    mode "1920x1080@119.879"

    // 可使用整数或小数缩放，例如用 1.5 表示 150%。
    scale 1

    // 允许逆时针旋转输出，有效值：
    // normal、90、180、270、flipped、flipped-90、flipped-180、flipped-270。
    transform "normal"

    // 该输出在全局坐标空间中的位置。
    // 会影响“focus-monitor-left”这类方向性跨屏操作与鼠标移动。
    // 光标只能在直接相邻的输出之间移动。
    // 定位时需考虑输出缩放与旋转：输出按逻辑（缩放后）像素计算尺寸。
    // 例如 3840×2160 缩放 2.0 时逻辑尺寸为 1920×1080，
    // 若要在其右侧紧贴放置另一块输出，则把那块的 x 设为 1920。
    // 若未设置位置或导致重叠，输出会被自动摆放。
    position x=1706 y=0
}

output "eDP-1" {
    //off
    mode "2560x1600@120.001"  // 笔记本在左边
    scale 1.5
    position x=0 y=0
}

