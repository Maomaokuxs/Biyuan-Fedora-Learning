/* 引入全局动态调色板 */
@import "~/.cache/by-mgr/hellwal/color-rofi.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
    font: "JetBrainsMono Nerd Font 12"; 
}

/* ==========================================
 * 1. 窗口层：100% 宽度，贴紧顶部
 * ========================================== */
window {
    anchor:     north;
    location:   north;
    width:      100%;
    y-offset:   0px; 
    
    background-color: @bg;
    border:     0px 0px 2px 0px;
    border-color: @accent;
    padding:    0px;
}

/* ==========================================
 * 2. 主容器：水平排列
 * ========================================== */
mainbox {
    orientation: horizontal;
    background-color: @bg;
    children:   [ inputbar, listview ];
}

/* ==========================================
 * 3. 左侧区域 (系统信息)：60% 宽度
 * ========================================== */
inputbar {
    width:      60%;
    padding:    5px 15px;
    children:   [ prompt ];
}

prompt {
    vertical-align: 0.5;
    text-color:     @accent;
    font:           "JetBrainsMono Nerd Font Bold 11";
}

/* ==========================================
 * 4. 右侧区域 (电源控件)：扩张到 40% 以容纳 6 个按钮
 * ========================================== */
listview {
    width:      40%;
    layout:     horizontal;
    spacing:    10px;      
    padding:    5px;  
    lines:      6;     /* 🔴 允许显示 6 个选项 */    
}

/* 单个按钮的外观 */
element {
    padding:        0px 12px;  /* 稍微减少一点内边距，防止太拥挤 */
    border-radius:  4px;
    text-color:     @fg;
    cursor:         pointer;
}

element selected {
    background-color: @accent;
    text-color:       @bg;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    text-color:       inherit;
}
