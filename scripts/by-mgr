#!/bin/bash
# Biyuan 配置管理引擎 (by-mgr) - 双擎驱动版 (备份恢复 + 部署同步)

REPO_DIR="$HOME/Documents/github/Biyuan-Fedora-Learning"
DOTFILES_DIR="$REPO_DIR/dotfiles"
BACKUP_ROOT="$HOME/.dotfiles_backup"

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'

if [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    echo -e "${BLUE}Biyuan 系统维护引擎 (by-mgr)${NC}"
    echo "用法: by-mgr    (启动配置调度菜单)"
    exit 0
fi

# ==========================================
# 辅助函数：获取模块对应的系统真实路径
# ==========================================
get_target_path() {
    local mod="$1"
    if [[ "$mod" == "colors" ]]; then echo "$HOME/.cache/hellwal"
    elif [[ "$mod" == "bash" ]]; then echo "$HOME/.bashrc"
    else echo "$HOME/.config/$mod"; fi
}

# 辅助函数：安全销毁目标路径 (清理旧链接或旧文件夹)
clean_target() {
    local target="$1"
    [ -L "$target" ] && rm -f "$target"
    [ -d "$target" ] && rm -rf "$target"
    [ -f "$target" ] && rm -f "$target"
}

# ==========================================
# 1. 预检测历史时间节点
# ==========================================
HAS_HISTORY=false
mapfile -t time_list < <(ls -d "$BACKUP_ROOT"/* 2>/dev/null | grep -E '[0-9]{8}_[0-9]+' | sort -r)
[ ${#time_list[@]} -gt 0 ] && HAS_HISTORY=true

# ==========================================
# 2. 渲染主菜单
# ==========================================
clear
echo -e "${CYAN}================================================${NC}"
echo -e "${BOLD}       Biyuan 配置管理引擎 (by-mgr)${NC}"
echo -e "${CYAN}================================================${NC}"

echo -e "${YELLOW}【第一部分：备份与恢复 (Backup & Restore)】${NC}"
echo "  1) 💾 创建系统当前配置的物理备份 (智能穿透 Stow 链接)"
if [ "$HAS_HISTORY" = true ]; then
    echo "  2) 🕰️ 从历史备份还原 (支持选择还原为 物理文件 或 Stow链接)"
    echo "  3) 🔄 逆向同步：将历史备份覆盖回 GitHub 主仓库"
else
    echo -e "  ${RED}(暂无历史备份，还原功能不可用)${NC}"
fi

echo -e "\n${YELLOW}【第二部分：更新与部署 (Sync & Deploy)】${NC}"
echo "  4) ☁️ 部署最新仓库配置 -> [全局 Stow 软链接模式]"
echo "  5) 📁 部署最新仓库配置 -> [全局 物理文件模式]"

echo -e "\n  0) 退出"
echo -e "${CYAN}------------------------------------------------${NC}"

read -p "选择操作模式 [0-5]: " mode
[[ "$mode" == "0" || -z "$mode" ]] && exit 0

trigger_visual_engine=false

# ==========================================
# 3. 核心逻辑执行分支
# ==========================================

case "$mode" in
    1)
        # --- 模式 1: 创建全新物理备份 ---
        echo -e "\n${YELLOW}>> 正在提取系统当前配置并创建物理备份...${NC}"
        date_tag=$(date +%Y%m%d_%H%M%S)
        current_backup_dir="$BACKUP_ROOT/$date_tag"
        backed_up_any=false

        mkdir -p "$current_backup_dir"
        for module in $(ls "$DOTFILES_DIR" 2>/dev/null); do
            src=$(get_target_path "$module")
            if [ -e "$src" ]; then
                # 过滤空文件夹
                if [ -d "$src" ] && [ -z "$(ls -A "$src" 2>/dev/null)" ]; then continue; fi
                
                rel_path="${src#$HOME/}"
                dest="$current_backup_dir/$rel_path"
                mkdir -p "$(dirname "$dest")"
                
                # 【核心】：-L 参数强制穿透软链接，抓取真实的物理文件
                cp -aL "$src" "$dest"
                backed_up_any=true
            fi
        done
        
        if [ "$backed_up_any" = true ]; then
            echo -e "${GREEN}✅ 备份完成！(所有配置已被提纯为物理文件)${NC}"
            echo -e "   备份路径: $current_backup_dir"
        else
            rm -rf "$current_backup_dir"
            echo -e "${RED}❌ 未找到任何需要备份的配置。${NC}"
        fi
        ;;

    2)
        # --- 模式 2: 从历史备份还原 ---
        if [ "$HAS_HISTORY" = false ]; then exit 1; fi

        # 选择时间点
        echo -e "\n${YELLOW}>> [步骤 1/3] 请选择历史备份点:${NC}"
        for i in "${!time_list[@]}"; do echo "  $((i+1))) $(basename "${time_list[i]}")"; done
        read -p "选择时间编号: " t_idx
        selected_time="${time_list[$((t_idx-1))]}"

        # 分析可用模块
        declare -a mod_list
        for mod in $(ls "$DOTFILES_DIR" 2>/dev/null); do
            check_path="${selected_time}/${$(get_target_path "$mod")#$HOME/}"
            [ -e "$check_path" ] && mod_list+=("$mod")
        done
        if [ ${#mod_list[@]} -eq 0 ]; then echo -e "${RED}该备份点下无可用配置！${NC}"; exit 1; fi
        
        # 选择模块
        echo -e "\n${YELLOW}>> [步骤 2/3] 请选择要恢复的模块:${NC}"
        for i in "${!mod_list[@]}"; do echo "  $((i+1))) ${mod_list[i]}"; done
        read -p "选择模块编号: " m_idx
        mod="${mod_list[$((m_idx-1))]}"

        target=$(get_target_path "$mod")
        backup_src="${selected_time}/${target#$HOME/}"

        # 核心：询问恢复模式
        echo -e "\n${YELLOW}>> [步骤 3/3] 请选择如何恢复 [ $mod ] 到系统中？${NC}"
        echo "  1) 📁 作为纯物理文件恢复 (直接复制到 $target)"
        echo "  2) ☁️  作为 Stow 软链接恢复 (先覆盖 Git 仓库，再进行链接)"
        read -p "选择恢复模式 [1/2]: " r_mode

        # 执行恢复前清理目标路径
        cd "$DOTFILES_DIR" && stow -D -t ~ "$mod" 2>/dev/null
        clean_target "$target"

        if [ "$r_mode" == "1" ]; then
            echo -e "${BLUE}>> 正在执行物理恢复...${NC}"
            if [ -d "$backup_src" ]; then
                mkdir -p "$target" && cp -a "$backup_src/." "$target/"
            else
                mkdir -p "$(dirname "$target")" && cp -a "$backup_src" "$target"
            fi
            echo -e "${GREEN}✅ $mod 已通过物理文件恢复。${NC}"
        elif [ "$r_mode" == "2" ]; then
            echo -e "${BLUE}>> 正在同步至仓库并建立 Stow 链接...${NC}"
            # 将备份文件放入 dotfiles 仓库
            repo_target="$DOTFILES_DIR/$mod"
            rm -rf "$repo_target" && mkdir -p "$repo_target"
            
            # 因为 colors 和 bash 路径特殊，需要还原 repo 里的层级结构
            if [[ "$mod" == "colors" ]]; then repo_target="$DOTFILES_DIR/$mod/.cache/hellwal"; mkdir -p "$repo_target"; fi
            if [[ "$mod" == "bash" ]]; then repo_target="$DOTFILES_DIR/$mod/.bashrc"; fi

            if [ -d "$backup_src" ]; then
                cp -a "$backup_src/." "$repo_target/"
            else
                cp -a "$backup_src" "$repo_target"
            fi
            
            # 建立链接
            cd "$DOTFILES_DIR" && stow -t ~ "$mod"
            echo -e "${GREEN}✅ $mod 已恢复至仓库，并重新建立 Stow 软链接。${NC}"
        fi
        trigger_visual_engine=true
        ;;

    3)
        # --- 模式 3: 逆向同步至主仓库 ---
        # ... (简化代码，调用模式 2 里的 r_mode 2 逻辑类似，如果需要可以后续补全，目前保留结构)
        echo -e "${YELLOW}提示: 在模式 2 中选择 '作为 Stow 软链接恢复' 即可同时完成逆向同步。${NC}"
        ;;

    4|5)
        # --- 模式 4/5: 全局部署最新仓库配置 ---
        if [ "$mode" == "4" ]; then
            echo -e "\n${YELLOW}>> 正在执行 Stow 全局软链接部署 (开发模式)...${NC}"
        else
            echo -e "\n${YELLOW}>> 正在执行物理脱离部署 (稳定模式)...${NC}"
        fi

        for module in $(ls "$DOTFILES_DIR" 2>/dev/null); do
            [[ "$module" == "bash" ]] && continue # 保护原生 .bashrc
            
            target=$(get_target_path "$module")
            
            # 通用清理步骤
            cd "$DOTFILES_DIR" && stow -D -t ~ "$module" 2>/dev/null
            clean_target "$target"

            if [ "$mode" == "4" ]; then
                # Stow 部署
                cd "$DOTFILES_DIR" && stow -t ~ "$module" 2>/dev/null
                echo -e "  [🔗 Linked] $module"
            else
                # 物理部署
                cp -a "$DOTFILES_DIR/$module/." "$HOME/" 2>/dev/null
                echo -e "  [📁 Physical] $module"
            fi
        done
        echo -e "${GREEN}✅ 全局部署完成！${NC}"
        trigger_visual_engine=true
        ;;
esac

# ==========================================
# 4. 自动化色彩与壁纸初始化
# ==========================================
if [ "$trigger_visual_engine" = true ]; then
    echo -e "\n${BLUE}-----------------------------------------------------${NC}"
    echo -e "${BLUE}>> Activating visual engine...${NC}"
    INIT_SCRIPT="$HOME/.config/niri/scripts/init-wallpaper.sh"
    ALT_INIT="$DOTFILES_DIR/niri/.config/niri/scripts/init-wallpaper.sh"
    
    if [ -f "$INIT_SCRIPT" ]; then
        chmod +x "$INIT_SCRIPT" && bash "$INIT_SCRIPT"
    elif [ -f "$ALT_INIT" ]; then
        chmod +x "$ALT_INIT" && bash "$ALT_INIT"
    fi
    echo -e "${GREEN}✨ by-mgr 任务流执行完毕！${NC}"
fi